{
  "name": "anki-languages-card",
  "version": "1.1.0",
  "description": "Modern Anki card templates for language learning",
  "main": "scripts/build.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "build:word": "node scripts/build.js word",
    "build:all": "node scripts/build.js --all",
    "sync": "node scripts/sync.js",
    "build:sync": "node scripts/build.js && node scripts/sync.js"
  },
  "keywords": [
    "anki",
    "flashcards",
    "language-learning",
    "spaced-repetition"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
